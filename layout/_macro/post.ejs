<article class="post">
  <header class="post-header">
    <h1 class="post-title">
      <% if (is_home()) { %>
      <a class="post-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
      <% } else { %>
      <%= post.title %>
      <% } %>
    </h1>

    <div class="post-meta">
      <span class="post-time">
        <%- full_date(post.date, 'YYYY-MM-DD') %>
      </span>
      <% if (post.author) { %>
      <span class="post-author">
        / <%= post.author %>
      </span>
      <% } %>
      <% if (post.categories && post.categories.length) { %>
      <span class="post-category">
        <% post.categories.forEach(function(category) { %>
        <a href="<%= url_for(category.path) %>"><%= category.name %></a>
        <% }); %>
      </span>
      <% } %>
      <% if (theme.reading_time && theme.reading_time.enable) { %>
      <span class="post-reading-time">
        <%- __('posts.readingtime', Math.max(1, Math.round((post.content.replace(/<[^>]+>/g, '').replace(/\s+/g, '').length) / (theme.reading_time.words_per_minute || 300)))) %>
      </span>
      <% } %>
      <% if (theme.leancloud && theme.leancloud.app_id && theme.leancloud.app_key) { %>
      <span class="post-visits" data-url="<%= url_for(post.path) %>" data-title="<%= post.title %>">
        <%= __('posts.visits') %> 0
      </span>
      <% } %>
    </div>
  </header>

  <%- partial("../_partial/_post/toc.ejs") %>

  <div class="post-content">
    <% if (is_home()) { %>
    <% var excerpt = ""; %>
    <% if (post.description) { %>
    <% excerpt = '<p>' + post.description + '</p>'; %>
    <% } else if (post.excerpt) { %>
    <% excerpt = post.excerpt; %>
    <% } %>

    <% if (excerpt) { %>
    <%- excerpt %>
    <div class="read-more">
      <a href="<%= url_for(post.path) %>" class="read-more-link"><%- __('posts.readmore') %></a>
    </div>
    <% } else if (theme.excerpt && theme.excerpt.enable) { %>
    <% // Auto-generate excerpt: strip code blocks but preserve inline formatting
       var html = post.content;
       var maxLen = theme.excerpt.length || 300;
       var truncated = '';

       // Remove code blocks, figures, and tables — they don't belong in excerpts
       var cleaned = html
         .replace(/<pre[^>]*>[\s\S]*?<\/pre>/g, '')
         .replace(/<figure[^>]*>[\s\S]*?<\/figure>/g, '')
         .replace(/<table[^>]*>[\s\S]*?<\/table>/g, '');

       // Calculate plain text length of cleaned HTML
       var plainLen = cleaned.replace(/<[^>]+>/g, '').replace(/\s+/g, '').length;

       if (plainLen <= maxLen) {
         // Short enough — use as-is
         truncated = cleaned;
       } else {
         // Too long — truncate at paragraph boundaries
         var parts = cleaned.split(/<\/p>/i);
         var accumulated = '';
         var accumulatedLen = 0;
         var cut = false;

         for (var pi = 0; pi < parts.length; pi++) {
           var part = parts[pi];
           if (!part.trim()) continue;
           var partLen = part.replace(/<[^>]+>/g, '').replace(/\s+/g, '').length;
           if (accumulatedLen + partLen > maxLen && accumulatedLen > 0) {
             cut = true;
             break;
           }
           if (accumulated) accumulated += '</p>';
           accumulated += part;
           accumulatedLen += partLen;
         }

         if (cut && accumulated) {
           truncated = accumulated + '</p>...';
         } else {
           // Fallback: keep first maxLen chars of plain text, preserving HTML
           var plain = cleaned.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
           if (plain.length > maxLen) {
             var txt = plain.substring(0, maxLen);
             var lastDot = Math.max(txt.lastIndexOf('。'), txt.lastIndexOf('. '));
             if (lastDot > maxLen * 0.4) txt = txt.substring(0, lastDot);
             else {
               var lastSp = txt.lastIndexOf(' ');
               if (lastSp > maxLen * 0.5) txt = txt.substring(0, lastSp);
             }
             truncated = '<p>' + txt + '...</p>';
           } else {
             truncated = cleaned;
           }
         }
       }
    %>
    <%- truncated %>
    <div class="read-more">
      <a href="<%= url_for(post.path) %>" class="read-more-link"><%- __('posts.readmore') %></a>
    </div>
    <% } else { %>
    <%- post.content %>
    <% } %>
    <% } else { %>
    <%- post.content %>
    <% } %>
  </div>

  <% if (!is_home()) { %>
  <%- partial("../_partial/_post/copyright.ejs") %>
  <%- partial("../_partial/_post/reward.ejs") %>
  <% } %>

  <% if (!is_home()) { %>
  <footer class="post-footer">
    <% if (post.tags && post.tags.length) { %>
    <div class="post-tags">
      <% post.tags.forEach(function(tag) { %>
      <a href="<%= url_for(tag.path) %>"><%= tag.name %></a>
      <% }); %>
    </div>
    <% } %>
    <%- partial("../_partial/pagination.ejs") %>
  </footer>
  <% } %>

</article>