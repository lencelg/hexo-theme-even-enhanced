<article class="post">
  <header class="post-header">
    <h1 class="post-title">
      <% if (is_home()) { %>
      <a class="post-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
      <% } else { %>
      <%= post.title %>
      <% } %>
    </h1>

    <div class="post-meta">
      <span class="post-time">
        <%- full_date(post.date, 'YYYY-MM-DD') %>
      </span>
      <% if (post.author) { %>
      <span class="post-author">
        / <%= post.author %>
      </span>
      <% } %>
      <% if (post.categories && post.categories.length) { %>
      <span class="post-category">
        <% post.categories.forEach(function(category) { %>
        <a href="<%= url_for(category.path) %>"><%= category.name %></a>
        <% }); %>
      </span>
      <% } %>
      <% if (theme.reading_time && theme.reading_time.enable) { %>
      <span class="post-reading-time">
        <%- __('posts.readingtime', Math.max(1, Math.round((post.content.replace(/<[^>]+>/g, '').replace(/\s+/g, '').length) / (theme.reading_time.words_per_minute || 300)))) %>
      </span>
      <% } %>
      <% if (theme.leancloud && theme.leancloud.app_id && theme.leancloud.app_key) { %>
      <span class="post-visits" data-url="<%= url_for(post.path) %>" data-title="<%= post.title %>">
        <%= __('posts.visits') %> 0
      </span>
      <% } %>
    </div>
  </header>

  <%- partial("../_partial/_post/toc.ejs") %>

  <div class="post-content">
    <% if (is_home()) { %>
    <% var excerpt = ""; %>
    <% if (post.description) { %>
    <% excerpt = '<p>' + post.description + '</p>'; %>
    <% } else if (post.excerpt) { %>
    <% excerpt = post.excerpt; %>
    <% } %>

    <% if (excerpt) { %>
    <%- excerpt %>
    <div class="read-more">
      <a href="<%= url_for(post.path) %>" class="read-more-link"><%- __('posts.readmore') %></a>
    </div>
    <% } else if (theme.excerpt && theme.excerpt.enable) { %>
    <% // Auto-generate excerpt: truncate at paragraph or before code blocks
    var html = post.content;
    var maxLen = theme.excerpt.length || 300;
    var truncated = '';
    var plainText = html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    var searchPos = 0;
    var breakPos = -1;
    var paraCount = 0;

    while (paraCount < 3 && searchPos < html.length) {
      var nextPara = html.indexOf('</p>', searchPos);
      if (nextPara === -1) break;

      // Find the nearest code block or large block element before this paragraph
      var prePos = html.indexOf('<pre', searchPos);
      var figurePos = html.indexOf('<figure', searchPos);
      var tablePos = html.indexOf('<table', searchPos);
      var nearestBlock = nextPara;
      if (prePos !== -1 && prePos < nearestBlock) nearestBlock = prePos;
      if (figurePos !== -1 && figurePos < nearestBlock) nearestBlock = figurePos;
      if (tablePos !== -1 && tablePos < nearestBlock) nearestBlock = tablePos;

      // If a block element comes before the paragraph, stop there
      if (nearestBlock < nextPara) {
        // Check if we have meaningful text before the block
        var textBeforeBlock = html.substring(searchPos, nearestBlock).replace(/<[^>]+>/g, '').trim();
        if (textBeforeBlock.length > 10) {
          breakPos = nearestBlock;
        }
        // Skip past this block element for the next iteration
        searchPos = html.indexOf('>', nearestBlock) + 1;
        if (searchPos < nearestBlock + 1) searchPos = nearestBlock + 100; // fallback
        continue;
      }

      paraCount++;
      var segmentText = html.substring(searchPos, nextPara).replace(/<[^>]+>/g, '').trim();

      // Stop at 2nd paragraph or when enough text gathered
      if (paraCount >= 2 || segmentText.length > 60) {
        breakPos = nextPara + 4;
        break;
      }
      searchPos = nextPara + 4;
    }

    if (breakPos > 0 && plainText.length > maxLen) {
      truncated = html.substring(0, breakPos) + '...';
    } else if (plainText.length > maxLen) {
      // Fallback: strip HTML and truncate plain text (break at word boundary)
      var txt = plainText.substring(0, maxLen);
      var lastSpace = txt.lastIndexOf(' ');
      if (lastSpace > 0) { txt = txt.substring(0, lastSpace); }
      truncated = '<p>' + txt + '...</p>';
    } else {
      truncated = html;
    }
    %>
    <%- truncated %>
    <div class="read-more">
      <a href="<%= url_for(post.path) %>" class="read-more-link"><%- __('posts.readmore') %></a>
    </div>
    <% } else { %>
    <%- post.content %>
    <% } %>
    <% } else { %>
    <%- post.content %>
    <% } %>
  </div>

  <% if (!is_home()) { %>
  <%- partial("../_partial/_post/copyright.ejs") %>
  <%- partial("../_partial/_post/reward.ejs") %>
  <% } %>

  <% if (!is_home()) { %>
  <footer class="post-footer">
    <% if (post.tags && post.tags.length) { %>
    <div class="post-tags">
      <% post.tags.forEach(function(tag) { %>
      <a href="<%= url_for(tag.path) %>"><%= tag.name %></a>
      <% }); %>
    </div>
    <% } %>
    <%- partial("../_partial/pagination.ejs") %>
  </footer>
  <% } %>

</article>